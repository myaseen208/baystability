Package: baystability
Type: Package
Title: Bayesian Stability Analysis of Genotype by Environment
        Interaction (GEI)
Version: 1.0.0
Date: 2026-11-04
Authors@R: c(
      person("Muhammad", "Yaseen", email = "myaseen208@gmail.com", role = c("aut", "cre"),
             comment = c(ORCID = "0000-0002-5923-1714"))
    , person("Diego", "Jarquin", email = "diego.jarquin@gmail.com", role = c("aut", "ctb"))
    , person("Sergio", "Perez-Elizalde", email = "sergiop@colpos.mx", role = c("aut", "ctb"))
